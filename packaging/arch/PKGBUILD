pkgname=heartwire
pkgver=0.2.0
pkgrel=1
pkgdesc='HeartWire — native Omarchy mini panel'
arch=('x86_64')
license=('MIT')
depends=('omarchy' 'quickshell' 'qt6-declarative' 'qt6-svg' 'libpulse' 'pipewire-pulse' 'opus' 'xdg-utils')
makedepends=('python' 'base-devel' 'rust' 'pkgconf' 'cmake')
options=('!lto' '!debug')
source=('source.tar.gz')
build() {
  cd "$srcdir/source"
  bash linux/build
}
check() {
  cd "$srcdir/source"
  bash linux/test
}
package() {
  cd "$srcdir/source"
  python3 linux/package.py --payload "$pkgdir"
}
